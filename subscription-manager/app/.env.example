# Copy to .env.local and fill in your values

# ── REQUIRED ──

# Web3Auth Client ID (from dashboard.web3auth.io)
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here

# Etherspot / Arka API Key (from dashboard.etherspot.io)
NEXT_PUBLIC_ARKA_API_KEY=your_etherspot_api_key_here

# Bundler URL for XDC Apothem (chain 51). Must support chain 51.
NEXT_PUBLIC_BUNDLER_URL=https://your-bundler-host/v1/51?api-key=YOUR_API_KEY_HERE

# AA smart account infra
NEXT_PUBLIC_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
NEXT_PUBLIC_SIMPLE_ACCOUNT_FACTORY_ADDRESS=0x91E60e0613810449d098b0b5Ec8b51A0FE8c8985
NEXT_PUBLIC_PAYMASTER_ADDRESS=0x12C8a71e89A482F8C5D22AAaE1e58b7Bb35a5489

# XDC Apothem RPC
NEXT_PUBLIC_APOTHEM_RPC_URL=https://erpc.apothem.network

# Chain ID (51 = Apothem Testnet)
NEXT_PUBLIC_CHAIN_ID=51

# Block Explorer
NEXT_PUBLIC_EXPLORER_URL=https://testnet.xdcscan.com/

# ── CONTRACTS ──

# Deployed SubscriptionManager contract
NEXT_PUBLIC_SUBSCRIPTION_MANAGER_ADDRESS=0xe8271C9Bc2255A41cd2AB53FbfB69CE4B5f3032E

# Service ERC20 Tokens (deployed on XDC Apothem)
NEXT_PUBLIC_NETFLIX_TOKEN_ADDRESS=0x896F79883Bf0620Afcd3D8942f1Db8d3F447AE84
NEXT_PUBLIC_SPOTIFY_TOKEN_ADDRESS=0x9F00925759A9F0FEb13373336B761A7267AE66a9
NEXT_PUBLIC_TOKEN_A_ADDRESS=0x896F79883Bf0620Afcd3D8942f1Db8d3F447AE84
NEXT_PUBLIC_TOKEN_B_ADDRESS=0x9F00925759A9F0FEb13373336B761A7267AE66a9

NEXT_PUBLIC_YOUTUBE_TOKEN_ADDRESS=0x591CCebbd943a2F9a11F64eBf627d86600a0f38e
NEXT_PUBLIC_JIOHOTSTAR_TOKEN_ADDRESS=0x87CB2de7edc1B9D725a5a6DeDdcbEF7e36fe3084
NEXT_PUBLIC_CLAUDE_TOKEN_ADDRESS=0xA228078133e812677533166A44187c1Ae696687A
NEXT_PUBLIC_COPILOT_TOKEN_ADDRESS=0x4c4456bF7A0e572D2C697626025DcB6d3D3Df7D1

# ── AA INFRASTRUCTURE (deployed on XDC Apothem testnet) ──
# These contracts enable Account Abstraction gas sponsorship.
# When Etherspot's infrastructure is down, the app falls back to our own relay.

NEXT_PUBLIC_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
NEXT_PUBLIC_SIMPLE_ACCOUNT_FACTORY_ADDRESS=0x91E60e0613810449d098b0b5Ec8b51A0FE8c8985
NEXT_PUBLIC_PAYMASTER_ADDRESS=0x8361Fae5A25e71C2E1db35cDE13E7150bB7b1a42

# ── SERVER-SIDE ONLY (do NOT prefix with NEXT_PUBLIC_) ──

# Deployer private key — used by /api/faucet to mint test tokens
# Must be the wallet that deployed the token contracts (owns faucetMint)
FAUCET_PRIVATE_KEY=0x_your_deployer_private_key_here

# Keeper wallet — signs auto-renewal transactions via cron
# Create a fresh wallet, fund with ~10 tXDC for gas, paste key here
KEEPER_PRIVATE_KEY=0x_your_keeper_private_key_here

# AA relay + paymaster signing keys for gasless fallback when Etherspot is unavailable.
# The app now prefers RELAYER_PRIVATE_KEY, then DEPLOYER_PRIVATE_KEY, then PAYMASTER_PRIVATE_KEY.
# To charge deployer-side infra (not user), set DEPLOYER_PRIVATE_KEY at minimum.
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here
RELAYER_PRIVATE_KEY=0x_optional_dedicated_relayer_private_key_here

# Verifying paymaster contract + signer key for /api/aa/paymaster-sign
PAYMASTER_ADDRESS=0x_your_verifying_paymaster_address_here
PAYMASTER_OWNER_PRIVATE_KEY=0x_optional_paymaster_owner_private_key_here
PAYMASTER_PRIVATE_KEY=0x_legacy_paymaster_signer_private_key_here

# EntryPoint v0.7 on Apothem (optional override)
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Web3Auth SMS Connection ID (optional)
NEXT_PUBLIC_WEB3AUTH_SMS_CONNECTION_ID=your_project_sms
